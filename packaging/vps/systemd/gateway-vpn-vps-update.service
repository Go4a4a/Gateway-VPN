[Unit]
Description=Apply one verified pointer-compatible Gateway VPN VPS update
Documentation=file:///opt/gateway-vpn-vps/current/share/doc/OPERATIONS.md
After=gateway-vpn-vps-agent.service gateway-vpn-vps-update-recovery.service
Requires=gateway-vpn-vps-update-recovery.service
Conflicts=gateway-vpn-vps-restore.service gateway-vpn-vps-fabric.service gateway-vpn-vps-update-finalize.service
OnFailure=gateway-vpn-vps-update-recovery.service
ConditionPathExists=|!/var/lib/gateway-vpn-vps/install-transactions/active
ConditionPathExists=|/run/gateway-vpn-vps-install-authorized
ConditionPathIsSymbolicLink=!/var/lib/gateway-vpn-vps/install-transactions/active
ConditionPathIsSymbolicLink=!/run/gateway-vpn-vps-install-authorized

[Service]
Type=oneshot
User=root
Group=root
Environment=GATEWAY_VPN_VPS_UPDATE_UNIT=1
ExecStart=/opt/gateway-vpn-vps/recovery/bin/gateway-vpn-vps-agent update-apply --config /etc/gateway-vpn-vps/config.yaml --apply
ExecStopPost=/usr/bin/rm -f /run/gateway-vpn-vps-update-live /var/lib/gateway-vpn-vps/agent/update.trigger
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
ReadOnlyPaths=/etc/gateway-vpn-vps /var/lib/gateway-vpn-vps/agent/secrets
ReadWritePaths=/opt/gateway-vpn-vps /var/lib/gateway-vpn-vps/agent /var/lib/gateway-vpn-vps-privileged /run/systemd
SystemCallArchitectures=native
