[Unit]
Description=Recover an interrupted Gateway VPN VPS update before Agent startup
Documentation=file:///opt/gateway-vpn-vps/recovery/share/doc/OPERATIONS.md
DefaultDependencies=no
After=local-fs.target gateway-vpn-vps-install-recovery.service
Before=network.target gateway-vpn-vps-restore-recovery.service gateway-vpn-vps-fabric-recovery.service gateway-vpn-vps-agent.service
ConditionPathExists=|!/var/lib/gateway-vpn-vps/install-transactions/active
ConditionPathExists=|/run/gateway-vpn-vps-install-authorized
ConditionPathExists=!/run/gateway-vpn-vps-update-live
ConditionPathIsSymbolicLink=!/var/lib/gateway-vpn-vps/install-transactions/active
ConditionPathIsSymbolicLink=!/run/gateway-vpn-vps-install-authorized
ConditionPathIsSymbolicLink=!/run/gateway-vpn-vps-update-live

[Service]
Type=oneshot
User=root
Group=root
Environment=GATEWAY_VPN_VPS_UPDATE_RECOVERY_UNIT=1
ExecStart=/opt/gateway-vpn-vps/recovery/bin/gateway-vpn-vps-agent update-recover --config /etc/gateway-vpn-vps/config.yaml --apply
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
ReadOnlyPaths=/etc/gateway-vpn-vps /var/lib/gateway-vpn-vps/agent/secrets
ReadWritePaths=/opt/gateway-vpn-vps /var/lib/gateway-vpn-vps/agent /var/lib/gateway-vpn-vps-privileged /run/systemd
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
