table inet gateway_vpn_vps {
    chain input {
        type filter hook input priority filter; policy accept;

        iifname "wg-mgmt" ct state established,related counter accept comment "gateway-vpn VPS Hub replies"
        iifname "wg-mgmt" ip saddr 10.80.0.10 ip daddr 10.80.0.1 ct state new tcp dport { 22, 9443 } counter accept comment "gateway-vpn VPS Hub administrator access"
        iifname "wg-mgmt" ip saddr 10.80.0.10 ip daddr 10.80.0.1 icmp type echo-request counter accept comment "gateway-vpn VPS Hub diagnostic ping"
        iifname "wg-mgmt" counter reject with icmpx type admin-prohibited comment "gateway-vpn deny VPS Hub to non-admin peers"
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        iifname "wg-mgmt" oifname "wg-mgmt" ip saddr 10.80.0.10 ip daddr 10.80.0.2 ct state new tcp dport { __GATEWAY_TCP_PORTS__ } counter accept comment "gateway-vpn admin management"
        iifname "wg-mgmt" oifname "wg-mgmt" ip saddr 10.80.0.10 ip daddr 10.80.0.2 icmp type echo-request counter accept comment "gateway-vpn admin diagnostic ping"
        iifname "wg-mgmt" oifname "wg-mgmt" ip saddr 10.80.0.2 ip daddr 10.80.0.10 ct state established,related counter accept comment "gateway-vpn management replies"
        iifname "wg-mgmt" counter reject with icmpx type admin-prohibited comment "gateway-vpn deny other peer ingress forwarding"
        oifname "wg-mgmt" counter reject with icmpx type admin-prohibited comment "gateway-vpn deny other peer egress forwarding"
    }
}
