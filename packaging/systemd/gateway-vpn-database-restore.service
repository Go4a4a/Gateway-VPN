[Unit]
Description=Gateway VPN verified database and state restore
Documentation=file:///opt/gateway-vpn/current/share/doc/OPERATIONS.md
After=local-fs.target gateway-vpn-firewall.service gateway-vpn-firewall-guard.service
Requires=gateway-vpn-firewall.service gateway-vpn-firewall-guard.service
Conflicts=gateway-vpn.service gateway-vpn-network-broker.socket gateway-vpn-network-broker.service gateway-vpn-mihomo.service gateway-vpn-dnsmasq.service
Before=gateway-vpn.service gateway-vpn-network-broker.socket gateway-vpn-network-broker.service gateway-vpn-mihomo.service gateway-vpn-dnsmasq.service
OnSuccess=gateway-vpn-database-restore-resume.service
OnFailure=gateway-vpn-database-restore-resume.service
ConditionPathExists=/var/lib/gateway-vpn/recovery/pending-restore.json

[Service]
LogNamespace=gateway-vpn
Type=oneshot
Environment=GATEWAY_VPN_DATABASE_RESTORE_UNIT=1
ExecStartPre=/opt/gateway-vpn/current/bin/gateway-vpn firewall-boot --config /etc/gateway-vpn/config.yaml --apply
ExecStart=/opt/gateway-vpn/current/bin/gateway-vpn database-restore --config /etc/gateway-vpn/config.yaml --transaction-root /var/lib/gateway-vpn-privileged/restore-transactions --apply
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadOnlyPaths=/opt/gateway-vpn
ReadWritePaths=/etc/gateway-vpn /var/lib/gateway-vpn /var/lib/gateway-vpn-privileged/restore-transactions /run

[Install]
WantedBy=multi-user.target
