[Unit]
Description=Gateway VPN LAN DHCP and DNS
After=gateway-vpn-firewall.service gateway-vpn-firewall-guard.service gateway-vpn-network-recovery.service
Requires=gateway-vpn-firewall.service gateway-vpn-firewall-guard.service gateway-vpn-network-recovery.service
ConditionPathExists=/etc/gateway-vpn/dnsmasq.conf
ConditionPathExists=|!/var/lib/gateway-vpn-privileged/install-transactions/active
ConditionPathExists=|/run/gateway-vpn-install-authorized
ConditionPathIsSymbolicLink=!/var/lib/gateway-vpn-privileged/install-transactions/active
ConditionPathIsSymbolicLink=!/run/gateway-vpn-install-authorized

[Service]
LogNamespace=gateway-vpn
Type=simple
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/gateway-vpn/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq --no-daemon --conf-file=/etc/gateway-vpn/dnsmasq.conf
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/gateway-vpn/dnsmasq
ReadOnlyPaths=/etc/gateway-vpn

[Install]
WantedBy=multi-user.target
