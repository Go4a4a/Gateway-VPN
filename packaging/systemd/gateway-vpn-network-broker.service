[Unit]
Description=Gateway VPN privileged network broker
Documentation=file:///opt/gateway-vpn/current/share/doc/OPERATIONS.md
Requires=gateway-vpn-network-broker.socket gateway-vpn-update-recovery.service gateway-vpn-network-recovery.service gateway-vpn-firewall.service gateway-vpn-firewall-guard.service
After=gateway-vpn-update-recovery.service gateway-vpn-database-restore-boot.service gateway-vpn-network-recovery.service gateway-vpn-firewall.service gateway-vpn-firewall-guard.service
Wants=gateway-vpn-database-restore-boot.service

[Service]
LogNamespace=gateway-vpn
Type=simple
ExecStart=/opt/gateway-vpn/current/bin/gateway-vpn network-broker --config /etc/gateway-vpn/config.yaml --transaction-root /var/lib/gateway-vpn-privileged/network-transactions --apply
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SYS_BOOT
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SYS_BOOT
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadOnlyPaths=/opt/gateway-vpn /var/lib/gateway-vpn/secrets /var/lib/gateway-vpn/tls /var/lib/gateway-vpn/subscriptions /var/lib/gateway-vpn/mihomo /var/lib/gateway-vpn/transactions /var/lib/gateway-vpn/update-staging
ReadWritePaths=/etc/gateway-vpn /etc/systemd/journald@gateway-vpn.conf.d /var/lib/gateway-vpn /var/lib/gateway-vpn/secrets/wireguard-ingress /var/lib/gateway-vpn-privileged/network-transactions /var/log/gateway-vpn /run

[Install]
WantedBy=multi-user.target
