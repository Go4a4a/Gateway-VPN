[Unit]
Description=Gateway VPN recover unfinished network apply
Documentation=file:///opt/gateway-vpn/current/share/doc/OPERATIONS.md
DefaultDependencies=no
StartLimitIntervalSec=0
After=local-fs.target gateway-vpn-firewall.service gateway-vpn-firewall-guard.service gateway-vpn-database-restore-boot.service
Requires=gateway-vpn-firewall.service gateway-vpn-firewall-guard.service
Wants=gateway-vpn-database-restore-boot.service
Before=gateway-vpn-watchdog.service gateway-vpn-network-broker.service gateway-vpn.service gateway-vpn-dnsmasq.service
ConditionPathExists=/etc/gateway-vpn/config.yaml

[Service]
LogNamespace=gateway-vpn
Type=oneshot
ExecStart=/opt/gateway-vpn/current/bin/gateway-vpn network-recover --config /etc/gateway-vpn/config.yaml --transaction-root /var/lib/gateway-vpn-privileged/network-transactions --apply
ExecStartPost=/usr/bin/chown -R --no-dereference gateway-vpn:gateway-vpn /var/lib/gateway-vpn/backups /var/lib/gateway-vpn/recovery
ExecStartPost=/usr/bin/chown --no-dereference gateway-vpn:gateway-vpn /var/lib/gateway-vpn/state.db
ExecStartPost=/usr/bin/find /var/lib/gateway-vpn -maxdepth 1 -type f -name state.db-* -exec /usr/bin/chown --no-dereference gateway-vpn:gateway-vpn {} +
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadOnlyPaths=/opt/gateway-vpn /var/lib/gateway-vpn/secrets /var/lib/gateway-vpn/tls /var/lib/gateway-vpn/subscriptions /var/lib/gateway-vpn/mihomo /var/lib/gateway-vpn/transactions /var/lib/gateway-vpn/update-staging
ReadWritePaths=/etc/gateway-vpn /var/lib/gateway-vpn /var/lib/gateway-vpn-privileged/network-transactions /run

[Install]
WantedBy=multi-user.target
