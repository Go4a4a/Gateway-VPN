[Unit]
Description=Resume Gateway VPN management after verified restore attempt
Documentation=file:///opt/gateway-vpn/current/share/doc/OPERATIONS.md
After=gateway-vpn-database-restore.service

[Service]
LogNamespace=gateway-vpn
Type=oneshot
ExecStart=/usr/bin/systemctl start gateway-vpn-network-broker.socket
ExecStart=/usr/bin/systemctl start gateway-vpn.service
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
