[Unit]
Description=Gateway VPN independent network rollback for %i
Documentation=file:///opt/gateway-vpn/current/share/doc/OPERATIONS.md
DefaultDependencies=no
After=local-fs.target
Before=gateway-vpn.service gateway-vpn-dnsmasq.service

[Service]
LogNamespace=gateway-vpn
Type=oneshot
ExecStart=/opt/gateway-vpn/current/bin/gateway-vpn network-rollback --id %i --transaction-root /var/lib/gateway-vpn-privileged/network-transactions --apply
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadOnlyPaths=/opt/gateway-vpn
ReadWritePaths=/etc/gateway-vpn /var/lib/gateway-vpn-privileged/network-transactions /var/lib/gateway-vpn/dnsmasq /run
