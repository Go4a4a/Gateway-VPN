interface=__LAN_INTERFACE__
bind-dynamic
listen-address=__LAN_IP__
port=53
dhcp-authoritative
dhcp-range=__DHCP_START__,__DHCP_END__,__NETMASK__,12h
dhcp-option=option:router,__LAN_IP__
dhcp-option=option:dns-server,__LAN_IP__
domain-needed
bogus-priv
no-resolv
server=127.0.0.1#1053
cache-size=0
log-facility=-
dhcp-leasefile=/var/lib/gateway-vpn-dnsmasq/dnsmasq.leases
pid-file=/run/gateway-vpn-dnsmasq.pid
