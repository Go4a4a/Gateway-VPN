FROM ubuntu@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        dbus \
        dnsmasq-base \
        iproute2 \
        kmod \
        nftables \
        procps \
        systemd \
        systemd-sysv \
        systemd-timesyncd \
        wireguard-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl enable systemd-networkd.service systemd-timesyncd.service

# systemd-timesyncd intentionally skips generic containers. This privileged,
# disposable rehearsal needs a real NTP peer so installer clock preflight is
# exercised rather than inherited intermittently from the WSL2 host kernel.
RUN install -d -m 0755 /etc/systemd/system/systemd-timesyncd.service.d \
    && printf '[Unit]\nConditionVirtualization=\n' \
        >/etc/systemd/system/systemd-timesyncd.service.d/gateway-vpn-rehearsal.conf

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
